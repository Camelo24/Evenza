{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@backend/*": ["./src/*"],
      "@db/client": ["./drizzle/client"],
      "@db/schema": ["./drizzle/schema"]
    }
  },
  "include": ["src/**/*", "drizzle/**/*"]
}
